# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
# Use a separately configured judge in quality evaluation to reduce self-judging bias.
EVAL_JUDGE_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# Production upgrade option (not implemented in this MVP): PostgreSQL.
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- Accuracy-first RAG ----
# Default points to the approved dataset packaged inside this repository.
KNOWLEDGE_BASE_DIR=./metadata
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=2.2
MAX_CONTEXT_CHARS=18000
# true = refuse all synthesized answers when OPENAI_API_KEY is missing
REQUIRE_LLM_FOR_ANSWERS=false
# Fail closed when the canonical dataset has not been reviewed recently.
KNOWLEDGE_MAX_AGE_DAYS=30

# ---- Safe grounded-answer cache ----
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=900
RESPONSE_CACHE_MAX_ENTRIES=500

# ---- Session / staff handover ----
SESSION_TTL_MINUTES=1440
SESSION_MAX_TURNS=8
# Generate a long random secret in production. Staff routes are disabled when empty.
STAFF_API_TOKEN=
# Production: use separate, revocable identities rather than the development token.
# Value must be valid JSON, for example: STAFF_TOKENS={"admissions-a":"replace-with-long-secret"}
STAFF_TOKENS={}
# Admin identities manage staff groups and ticket routing. Use a separate,
# revocable long secret for each Admin, for example:
# Single-admin deployment shortcut:
# ADMIN_API_TOKEN=replace-with-a-long-random-secret
# ADMIN_TOKENS={"admin-01":"replace-with-long-secret"}
ADMIN_API_TOKEN=
ADMIN_TOKENS={}
# Per-client, in-process limit for write endpoints. Put a shared rate limiter in
# front of multiple backend instances in production.
RATE_LIMIT_PER_MINUTE=30

# ---- Applicant authentication ----
# Google Cloud OAuth Web application credentials.
FRONTEND_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_HOURS=168
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# SMTP is used only to send registration OTP emails. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VinUni Guide
SMTP_STARTTLS=true
# Railway Free/Trial/Hobby blocks outbound SMTP. Use Resend's HTTPS API there.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# Copy frontend/.env.example to frontend/.env.local for local development.
# NEXT_PUBLIC_API_URL is a frontend build-time variable, not a backend setting.
